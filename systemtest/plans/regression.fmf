summary: Virt-who regression test suite
description: |
    Unified CTC regression plan for virt-who.
    Executes pytest suites against a provisioned RHEL guest with
    the hypervisor and subscription server configured via environment variables.

environment:
    HYPERVISOR: libvirt
    REGISTER: rhsm
    # Destination tier (CCT-3155): container (default) deploys the
    # containerized Candlepin pod per run (prepare-candlepin.sh) and
    # the generator fills [rhsm] with the synthetic container values;
    # stage restores the sentinel/env flow for the scheduled
    # fidelity tier. Stated here so the plan documents the default.
    VIRTWHO_DESTINATION: container

prepare:
    - name: Install dependencies
      how: shell
      script: ./systemtest/scripts/install-deps.sh

    - name: Setup localhost SSH
      how: shell
      script: ./systemtest/scripts/setup-ssh.sh

    - name: Configure proxy
      how: shell
      script: ./systemtest/scripts/configure-proxy.sh

    - name: Setup virtwho-test
      how: shell
      script: ./systemtest/scripts/setup-virtwho-test.sh

    - name: Deploy containerized Candlepin destination
      how: shell
      script: ./systemtest/scripts/prepare-candlepin.sh

discover:
    how: shell
    tests:
      - name: /tests/regression
        test: ./systemtest/scripts/run-tests.sh
        duration: 4h
      - name: /tests/bootc-lint
        test: ./systemtest/tests/bootc/test-bootc-lint.sh
        duration: 15m

execute:
    how: tmt

finish:
    - name: Clean up generated secrets
      how: shell
      script: ./systemtest/scripts/cleanup-secrets.sh
